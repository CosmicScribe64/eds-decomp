diff --git a/gcc/regoracle.c b/gcc/regoracle.c
new file mode 100644
index 0000000..22b7dfe
--- /dev/null
+++ b/gcc/regoracle.c
@@ -0,0 +1,673 @@
+/* regoracle: register-allocation trace for tools/regoracle.py (EDS decomp).
+
+   Environment:
+     REGORACLE_OUT=FILE       append the trace here
+     REGORACLE_FUNC=NAME      trace only this function
+     REGORACLE_PRIO=R=P,...   what-if: global-alloc priority of pseudo R is P (allocno_compare units)
+     REGORACLE_FORCE=R=H,...  what-if: global-alloc gives pseudo R only hard reg H
+
+   Record types written (one per line, first token is the type):
+     F name                       function starts (after RTL expansion)
+     O regno uid line rtx         first set of a pseudo in the expanded RTL (its source expression)
+     U uid line                   source line of an insn created during expansion
+     N regno pass line mode       pseudo creation (pass that created it)
+     D kind name origin line rtx  a decl and its DECL_RTL (at global-alloc time)
+     I/J/K/L/NB/NE/B ...          the insn chain at global-alloc time (see ro_dump_chain)
+     RF uid depth regno:delta..   REG_N_REFS contributions (recompute_reg_usage)
+     LV uid regno...              pseudos live at an insn (first life analysis)
+     EQ regno uid / EQZ regno     REG_EQUIV live-length doubling / refs zeroed (local-alloc)
+     LQS/LQ ...                   local-alloc quantities
+     G*, A, C, P, T, Q, Z         global-alloc tables, find_reg trace, dispositions
+     SP, SPILLS, RL, RLI          reload: spilled pseudos, spill regs, reload regs, reload insns  */
+
+#include "config.h"
+#include "system.h"
+#include "rtl.h"
+#include "tree.h"
+#include "regs.h"
+#include "hard-reg-set.h"
+#include "basic-block.h"
+#include "flags.h"
+#include "regoracle.h"
+
+extern rtx get_pool_constant (rtx);
+
+FILE *ro_file;
+int ro_active;
+const char *ro_pass = "expand";
+
+static char *ro_func;
+static int *ro_reg_line;
+static const char **ro_reg_pass;
+static int ro_reg_alloc;
+static int *ro_uid_line;
+static int ro_uid_alloc;
+
+#define RO_MAXOVR 4096
+static int ro_nprio, ro_prio_reg[RO_MAXOVR], ro_prio_val[RO_MAXOVR];
+static int ro_nforce, ro_force_reg[RO_MAXOVR], ro_force_hard[RO_MAXOVR];
+
+extern int emit_lineno;
+
+static void
+ro_parse_pairs (const char *s, int *n, int *a, int *b)
+{
+  *n = 0;
+  while (s && *s && *n < RO_MAXOVR)
+    {
+      char *end;
+      long x, y;
+      while (*s == ',' || *s == ' ')
+	s++;
+      if (!*s)
+	break;
+      x = strtol (s, &end, 10);
+      if (*end != '=')
+	break;
+      y = strtol (end + 1, &end, 10);
+      a[*n] = (int) x;
+      b[*n] = (int) y;
+      (*n)++;
+      s = end;
+    }
+}
+
+void
+ro_init (void)
+{
+  char *out = getenv ("REGORACLE_OUT");
+  ro_func = getenv ("REGORACLE_FUNC");
+  if (out && *out && ro_func && *ro_func)
+    ro_file = fopen (out, "a");
+  if (ro_file && getenv ("REGORACLE_UNBUFFERED"))
+    setvbuf (ro_file, NULL, _IONBF, 0);
+  ro_parse_pairs (getenv ("REGORACLE_PRIO"), &ro_nprio, ro_prio_reg, ro_prio_val);
+  ro_parse_pairs (getenv ("REGORACLE_FORCE"), &ro_nforce, ro_force_reg, ro_force_hard);
+}
+
+void
+ro_reset_function (void)
+{
+  int i;
+  ro_pass = "expand";
+  for (i = 0; i < ro_reg_alloc; i++)
+    {
+      ro_reg_line[i] = 0;
+      ro_reg_pass[i] = 0;
+    }
+  for (i = 0; i < ro_uid_alloc; i++)
+    ro_uid_line[i] = 0;
+}
+
+static void
+ro_grow (int **arr, const char ***parr, int *alloc, int need)
+{
+  int n = *alloc, i;
+  if (need < n)
+    return;
+  while (n <= need)
+    n = n ? n * 2 : 1024;
+  *arr = (int *) xrealloc (*arr, n * sizeof (int));
+  for (i = *alloc; i < n; i++)
+    (*arr)[i] = 0;
+  if (parr)
+    {
+      *parr = (const char **) xrealloc (*parr, n * sizeof (char *));
+      for (i = *alloc; i < n; i++)
+	(*parr)[i] = 0;
+    }
+  *alloc = n;
+}
+
+void
+ro_new_reg (int regno)
+{
+  if (!ro_file)
+    return;
+  ro_grow (&ro_reg_line, &ro_reg_pass, &ro_reg_alloc, regno);
+  ro_reg_line[regno] = emit_lineno;
+  ro_reg_pass[regno] = ro_pass;
+}
+
+void
+ro_new_insn (int uid)
+{
+  if (!ro_file || strcmp (ro_pass, "expand"))
+    return;
+  ro_grow (&ro_uid_line, 0, &ro_uid_alloc, uid);
+  ro_uid_line[uid] = emit_lineno;
+}
+
+/* Compact one-line RTL printer.  */
+void
+ro_print_rtx (FILE *f, rtx x)
+{
+  int i, j;
+  const char *fmt;
+  enum rtx_code code;
+
+  if (x == 0)
+    {
+      fputs ("nil", f);
+      return;
+    }
+  code = GET_CODE (x);
+  switch (code)
+    {
+    case REG:
+      fprintf (f, "(reg:%s %d)", GET_MODE_NAME (GET_MODE (x)), REGNO (x));
+      return;
+    case CONST_INT:
+      fprintf (f, "%ld", (long) INTVAL (x));
+      return;
+    case SYMBOL_REF:
+      if (CONSTANT_POOL_ADDRESS_P (x))
+	{
+	  fputc ('=', f);
+	  ro_print_rtx (f, get_pool_constant (x));
+	}
+      else
+	fprintf (f, "`%s'", XSTR (x, 0));
+      return;
+    case LABEL_REF:
+      fprintf (f, "(label_ref %d)", XEXP (x, 0) ? INSN_UID (XEXP (x, 0)) : 0);
+      return;
+    case CODE_LABEL:
+      fprintf (f, "L%d", INSN_UID (x));
+      return;
+    case PC:
+      fputs ("pc", f);
+      return;
+    case CC0:
+      fputs ("cc0", f);
+      return;
+    case INSN:
+    case JUMP_INSN:
+    case CALL_INSN:
+    case NOTE:
+    case BARRIER:
+      fprintf (f, "#%d", INSN_UID (x));
+      return;
+    default:
+      break;
+    }
+  fprintf (f, "(%s", GET_RTX_NAME (code));
+  if (GET_MODE (x) != VOIDmode)
+    fprintf (f, ":%s", GET_MODE_NAME (GET_MODE (x)));
+  fmt = GET_RTX_FORMAT (code);
+  for (i = 0; i < GET_RTX_LENGTH (code); i++)
+    switch (fmt[i])
+      {
+      case 'e':
+	fputc (' ', f);
+	ro_print_rtx (f, XEXP (x, i));
+	break;
+      case 'E':
+      case 'V':
+	fputs (" [", f);
+	if (XVEC (x, i))
+	  for (j = 0; j < XVECLEN (x, i); j++)
+	    {
+	      if (j)
+		fputc (' ', f);
+	      ro_print_rtx (f, XVECEXP (x, i, j));
+	    }
+	fputc (']', f);
+	break;
+      case 'i':
+	fprintf (f, " %d", XINT (x, i));
+	break;
+      case 'w':
+	fprintf (f, " %ld", (long) XWINT (x, i));
+	break;
+      case 's':
+	if (XSTR (x, i))
+	  fprintf (f, " \"%s\"", XSTR (x, i));
+	break;
+      default:
+	break;
+      }
+  fputc (')', f);
+}
+
+/* Collect the pseudos mentioned in X into LIST (no duplicates).  */
+static int
+ro_collect_1 (rtx x, int *list, int n, int max)
+{
+  int i, j;
+  const char *fmt;
+  enum rtx_code code;
+  if (x == 0)
+    return n;
+  code = GET_CODE (x);
+  if (code == REG)
+    {
+      int r = REGNO (x);
+      if (r >= FIRST_PSEUDO_REGISTER)
+	{
+	  for (i = 0; i < n; i++)
+	    if (list[i] == r)
+	      return n;
+	  if (n < max)
+	    list[n++] = r;
+	}
+      return n;
+    }
+  if (code == INSN || code == JUMP_INSN || code == CALL_INSN || code == CODE_LABEL
+      || code == NOTE || code == BARRIER)
+    return n;
+  fmt = GET_RTX_FORMAT (code);
+  for (i = 0; i < GET_RTX_LENGTH (code); i++)
+    if (fmt[i] == 'e')
+      n = ro_collect_1 (XEXP (x, i), list, n, max);
+    else if (fmt[i] == 'E' && XVEC (x, i))
+      for (j = 0; j < XVECLEN (x, i); j++)
+	n = ro_collect_1 (XVECEXP (x, i, j), list, n, max);
+  return n;
+}
+
+int
+ro_collect_pseudos (rtx insn, int *list, int max)
+{
+  int n = ro_collect_1 (PATTERN (insn), list, 0, max);
+  if (GET_CODE (insn) == CALL_INSN)
+    n = ro_collect_1 (CALL_INSN_FUNCTION_USAGE (insn), list, n, max);
+  n = ro_collect_1 (REG_NOTES (insn), list, n, max);
+  return n;
+}
+
+/* Split the pseudos of an insn pattern into sets and uses.  */
+static void
+ro_sets_uses (rtx x, int dest, int *s, int *ns, int *u, int *nu, int max)
+{
+  int i, j;
+  const char *fmt;
+  enum rtx_code code;
+  if (x == 0)
+    return;
+  code = GET_CODE (x);
+  switch (code)
+    {
+    case REG:
+      if (REGNO (x) >= FIRST_PSEUDO_REGISTER)
+	{
+	  int *l = dest ? s : u, *n = dest ? ns : nu;
+	  for (i = 0; i < *n; i++)
+	    if (l[i] == (int) REGNO (x))
+	      return;
+	  if (*n < max)
+	    l[(*n)++] = REGNO (x);
+	}
+      return;
+    case SET:
+      ro_sets_uses (SET_DEST (x), 1, s, ns, u, nu, max);
+      ro_sets_uses (SET_SRC (x), 0, s, ns, u, nu, max);
+      return;
+    case CLOBBER:
+      ro_sets_uses (XEXP (x, 0), 1, s, ns, u, nu, max);
+      return;
+    case MEM:
+      ro_sets_uses (XEXP (x, 0), 0, s, ns, u, nu, max);
+      return;
+    case SUBREG:
+    case STRICT_LOW_PART:
+      ro_sets_uses (XEXP (x, 0), dest, s, ns, u, nu, max);
+      return;
+    case ZERO_EXTRACT:
+    case SIGN_EXTRACT:
+      ro_sets_uses (XEXP (x, 0), dest, s, ns, u, nu, max);
+      ro_sets_uses (XEXP (x, 1), 0, s, ns, u, nu, max);
+      ro_sets_uses (XEXP (x, 2), 0, s, ns, u, nu, max);
+      return;
+    case INSN:
+    case JUMP_INSN:
+    case CALL_INSN:
+    case CODE_LABEL:
+    case NOTE:
+    case BARRIER:
+      return;
+    default:
+      break;
+    }
+  fmt = GET_RTX_FORMAT (code);
+  for (i = 0; i < GET_RTX_LENGTH (code); i++)
+    if (fmt[i] == 'e')
+      ro_sets_uses (XEXP (x, i), 0, s, ns, u, nu, max);
+    else if (fmt[i] == 'E' && XVEC (x, i))
+      for (j = 0; j < XVECLEN (x, i); j++)
+	ro_sets_uses (XVECEXP (x, i, j), 0, s, ns, u, nu, max);
+}
+
+void
+ro_insn_regs (rtx insn, int *s, int *ns, int *u, int *nu, int max)
+{
+  *ns = *nu = 0;
+  ro_sets_uses (PATTERN (insn), 0, s, ns, u, nu, max);
+  if (GET_CODE (insn) == CALL_INSN)
+    ro_sets_uses (CALL_INSN_FUNCTION_USAGE (insn), 0, s, ns, u, nu, max);
+}
+
+static void
+ro_print_list (const char *key, int *l, int n)
+{
+  int i;
+  fprintf (ro_file, " %s=", key);
+  for (i = 0; i < n; i++)
+    fprintf (ro_file, i ? ",%d" : "%d", l[i]);
+}
+
+/* The insn chain with loop notes, blocks, per-insn pseudos and patterns.
+     I uid code d=DEPTH s=SETS u=USES dead=DEAD unused=UNUSED eq=EQUIV-REG\tPATTERN
+     L uid (label)   NB / NE uid (loop begin / end)   NV uid (loop vtop)  NC uid (loop cont)
+     B block head end  */
+void
+ro_dump_chain (rtx first)
+{
+  rtx insn, link;
+  int depth = 1, b;
+  int s[256], u[256], d[256], un[256], ns, nu, nd, nun;
+
+  for (b = 0; b < n_basic_blocks; b++)
+    fprintf (ro_file, "B %d %d %d\n", b, INSN_UID (BLOCK_HEAD (b)), INSN_UID (BLOCK_END (b)));
+  for (insn = first; insn; insn = NEXT_INSN (insn))
+    {
+      enum rtx_code code = GET_CODE (insn);
+      if (code == NOTE)
+	{
+	  int k = NOTE_LINE_NUMBER (insn);
+	  if (k == NOTE_INSN_LOOP_BEG)
+	    {
+	      depth++;
+	      fprintf (ro_file, "NB %d\n", INSN_UID (insn));
+	    }
+	  else if (k == NOTE_INSN_LOOP_END)
+	    {
+	      depth--;
+	      fprintf (ro_file, "NE %d\n", INSN_UID (insn));
+	    }
+	  else if (k == NOTE_INSN_LOOP_VTOP)
+	    fprintf (ro_file, "NV %d\n", INSN_UID (insn));
+	  else if (k == NOTE_INSN_LOOP_CONT)
+	    fprintf (ro_file, "NC %d\n", INSN_UID (insn));
+	  continue;
+	}
+      if (code == CODE_LABEL)
+	{
+	  fprintf (ro_file, "L %d\n", INSN_UID (insn));
+	  continue;
+	}
+      if (GET_RTX_CLASS (code) != 'i')
+	continue;
+      ro_insn_regs (insn, s, &ns, u, &nu, 256);
+      nd = nun = 0;
+      for (link = REG_NOTES (insn); link; link = XEXP (link, 1))
+	if (XEXP (link, 0) && GET_CODE (XEXP (link, 0)) == REG
+	    && REGNO (XEXP (link, 0)) >= FIRST_PSEUDO_REGISTER)
+	  {
+	    if (REG_NOTE_KIND (link) == REG_DEAD && nd < 256)
+	      d[nd++] = REGNO (XEXP (link, 0));
+	    else if (REG_NOTE_KIND (link) == REG_UNUSED && nun < 256)
+	      un[nun++] = REGNO (XEXP (link, 0));
+	  }
+      fprintf (ro_file, "I %d %s d=%d", INSN_UID (insn),
+	       code == JUMP_INSN ? "jump" : code == CALL_INSN ? "call" : "insn", depth);
+      ro_print_list ("s", s, ns);
+      ro_print_list ("u", u, nu);
+      ro_print_list ("dead", d, nd);
+      ro_print_list ("unused", un, nun);
+      for (link = REG_NOTES (insn); link; link = XEXP (link, 1))
+	if (REG_NOTE_KIND (link) == REG_EQUIV || REG_NOTE_KIND (link) == REG_EQUAL)
+	  {
+	    fprintf (ro_file, " %s=", REG_NOTE_KIND (link) == REG_EQUIV ? "equiv" : "equal");
+	    ro_print_rtx (ro_file, XEXP (link, 0));
+	  }
+      fputc ('\t', ro_file);
+      ro_print_rtx (ro_file, PATTERN (insn));
+      fputc ('\n', ro_file);
+    }
+}
+
+static void
+ro_walk_block (tree block, const char *origin)
+{
+  tree t;
+  if (block == 0)
+    return;
+  if (BLOCK_ABSTRACT_ORIGIN (block)
+      && TREE_CODE (BLOCK_ABSTRACT_ORIGIN (block)) == FUNCTION_DECL
+      && DECL_NAME (BLOCK_ABSTRACT_ORIGIN (block)))
+    origin = IDENTIFIER_POINTER (DECL_NAME (BLOCK_ABSTRACT_ORIGIN (block)));
+  for (t = BLOCK_VARS (block); t; t = TREE_CHAIN (t))
+    if ((TREE_CODE (t) == VAR_DECL || TREE_CODE (t) == PARM_DECL) && DECL_RTL (t))
+      {
+	fprintf (ro_file, "D %s %s %s %d ", TREE_CODE (t) == PARM_DECL ? "parm" : "var",
+		 DECL_NAME (t) ? IDENTIFIER_POINTER (DECL_NAME (t)) : "?", origin,
+		 DECL_SOURCE_LINE (t));
+	ro_print_rtx (ro_file, DECL_RTL (t));
+	fputc ('\n', ro_file);
+      }
+  for (t = BLOCK_SUBBLOCKS (block); t; t = BLOCK_CHAIN (t))
+    ro_walk_block (t, origin);
+}
+
+void
+ro_dump_decls (tree fndecl)
+{
+  tree t;
+  if (fndecl == 0)
+    fndecl = current_function_decl;
+  for (t = DECL_ARGUMENTS (fndecl); t; t = TREE_CHAIN (t))
+    if (DECL_RTL (t))
+      {
+	fprintf (ro_file, "D parm %s - %d ", DECL_NAME (t) ? IDENTIFIER_POINTER (DECL_NAME (t)) : "?",
+		 DECL_SOURCE_LINE (t));
+	ro_print_rtx (ro_file, DECL_RTL (t));
+	fputc ('\n', ro_file);
+      }
+  ro_walk_block (DECL_INITIAL (fndecl), "-");
+}
+
+void
+ro_begin_function (tree decl, rtx insns)
+{
+  rtx insn;
+  int i, max;
+  char *seen;
+
+  ro_active = 0;
+  if (!ro_file || !DECL_NAME (decl) || strcmp (IDENTIFIER_POINTER (DECL_NAME (decl)), ro_func))
+    return;
+  ro_active = 1;
+  fprintf (ro_file, "F %s\n", IDENTIFIER_POINTER (DECL_NAME (decl)));
+  for (insn = insns; insn; insn = NEXT_INSN (insn))
+    if (INSN_UID (insn) < ro_uid_alloc && ro_uid_line[INSN_UID (insn)]
+	&& GET_RTX_CLASS (GET_CODE (insn)) == 'i')
+      fprintf (ro_file, "U %d %d\n", INSN_UID (insn), ro_uid_line[INSN_UID (insn)]);
+  max = max_reg_num ();
+  seen = (char *) xmalloc (max + 1);
+  memset (seen, 0, max + 1);
+  for (insn = insns; insn; insn = NEXT_INSN (insn))
+    if (GET_RTX_CLASS (GET_CODE (insn)) == 'i')
+      {
+	rtx set = single_set (insn);
+	if (set && GET_CODE (SET_DEST (set)) == REG && REGNO (SET_DEST (set)) >= FIRST_PSEUDO_REGISTER
+	    && (int) REGNO (SET_DEST (set)) < max && !seen[REGNO (SET_DEST (set))])
+	  {
+	    int r = REGNO (SET_DEST (set));
+	    seen[r] = 1;
+	    fprintf (ro_file, "O %d %d %d ", r, INSN_UID (insn),
+		     INSN_UID (insn) < ro_uid_alloc ? ro_uid_line[INSN_UID (insn)] : 0);
+	    ro_print_rtx (ro_file, SET_SRC (set));
+	    fputc ('\n', ro_file);
+	  }
+      }
+  free (seen);
+}
+
+void
+ro_dump_regs (void)
+{
+  int i, max = max_reg_num ();
+  for (i = FIRST_PSEUDO_REGISTER; i < max && i < ro_reg_alloc; i++)
+    if (ro_reg_pass[i])
+      fprintf (ro_file, "N %d %s %d %s\n", i, ro_reg_pass[i], ro_reg_line[i],
+	       GET_MODE_NAME (GET_MODE (regno_reg_rtx[i])));
+}
+
+void
+ro_end_function (void)
+{
+  if (ro_active && ro_file)
+    {
+      fprintf (ro_file, "END\n");
+      fflush (ro_file);
+    }
+  ro_active = 0;
+}
+
+int
+ro_have_overrides (void)
+{
+  return ro_active && (ro_nprio || ro_nforce);
+}
+
+int
+ro_prio_override (int regno, int prio)
+{
+  int i;
+  if (!ro_active)
+    return prio;
+  for (i = 0; i < ro_nprio; i++)
+    if (ro_prio_reg[i] == regno)
+      return ro_prio_val[i];
+  return prio;
+}
+
+int
+ro_forced_reg (int regno)
+{
+  int i;
+  if (!ro_active)
+    return -1;
+  for (i = 0; i < ro_nforce; i++)
+    if (ro_force_reg[i] == regno)
+      return ro_force_hard[i];
+  return -1;
+}
+
+/* Pointer -> pseudo map of the shared REG rtx of every pseudo, taken before reload rewrites their
+   REGNO in place (alter_reg); final uses it to say which pseudo each hard-register operand was.  */
+struct ro_regmap { rtx x; int regno; };
+static struct ro_regmap *ro_map;
+static int ro_nmap;
+
+static int
+ro_map_cmp (const void *a, const void *b)
+{
+  const struct ro_regmap *p = a, *q = b;
+  return p->x < q->x ? -1 : p->x > q->x;
+}
+
+void
+ro_map_pseudos (void)
+{
+  int i, max = max_reg_num ();
+  ro_map = (struct ro_regmap *) xrealloc (ro_map, (max + 1) * sizeof (struct ro_regmap));
+  ro_nmap = 0;
+  for (i = FIRST_PSEUDO_REGISTER; i < max; i++)
+    if (regno_reg_rtx[i] && GET_CODE (regno_reg_rtx[i]) == REG)
+      {
+	ro_map[ro_nmap].x = regno_reg_rtx[i];
+	ro_map[ro_nmap].regno = i;
+	ro_nmap++;
+      }
+  qsort (ro_map, ro_nmap, sizeof (struct ro_regmap), ro_map_cmp);
+}
+
+static int
+ro_pseudo_of (rtx x)
+{
+  int lo = 0, hi = ro_nmap - 1;
+  while (lo <= hi)
+    {
+      int mid = (lo + hi) / 2;
+      if (ro_map[mid].x == x)
+	return ro_map[mid].regno;
+      if (ro_map[mid].x < x)
+	lo = mid + 1;
+      else
+	hi = mid - 1;
+    }
+  return -1;
+}
+
+static void
+ro_final_walk (rtx x, int dest, char *buf, int *len)
+{
+  int i, j;
+  const char *fmt;
+  enum rtx_code code;
+  if (x == 0)
+    return;
+  code = GET_CODE (x);
+  switch (code)
+    {
+    case REG:
+      if (*len < 900)
+	{
+	  int p = ro_pseudo_of (x);
+	  char item[40];
+	  if (p >= 0)
+	    sprintf (item, " %d:%d:%c", p, REGNO (x), dest ? 's' : 'u');
+	  else
+	    sprintf (item, " -:%d:%c", REGNO (x), dest ? 's' : 'u');
+	  if (!strstr (buf, item))
+	    {
+	      strcpy (buf + *len, item);
+	      *len += strlen (item);
+	    }
+	}
+      return;
+    case SET:
+      ro_final_walk (SET_DEST (x), 1, buf, len);
+      ro_final_walk (SET_SRC (x), 0, buf, len);
+      return;
+    case CLOBBER:
+      ro_final_walk (XEXP (x, 0), 1, buf, len);
+      return;
+    case MEM:
+      ro_final_walk (XEXP (x, 0), 0, buf, len);
+      return;
+    case SUBREG:
+    case STRICT_LOW_PART:
+      ro_final_walk (XEXP (x, 0), dest, buf, len);
+      return;
+    case INSN:
+    case JUMP_INSN:
+    case CALL_INSN:
+    case CODE_LABEL:
+    case NOTE:
+    case BARRIER:
+      return;
+    default:
+      break;
+    }
+  fmt = GET_RTX_FORMAT (code);
+  for (i = 0; i < GET_RTX_LENGTH (code); i++)
+    if (fmt[i] == 'e')
+      ro_final_walk (XEXP (x, i), 0, buf, len);
+    else if (fmt[i] == 'E' && XVEC (x, i))
+      for (j = 0; j < XVECLEN (x, i); j++)
+	ro_final_walk (XVECEXP (x, i, j), 0, buf, len);
+}
+
+/* FI uid pseudo:hardreg:s|u ...  (- for a register that is no pseudo's: reload or fixed reg).  */
+void
+ro_final_insn (rtx insn)
+{
+  char buf[1024];
+  int len = 0;
+  buf[0] = 0;
+  ro_final_walk (PATTERN (insn), 0, buf, &len);
+  fprintf (ro_file, "FI %d%s\n", INSN_UID (insn), buf);
+}
diff --git a/gcc/regoracle.h b/gcc/regoracle.h
new file mode 100644
index 0000000..199216d
--- /dev/null
+++ b/gcc/regoracle.h
@@ -0,0 +1,36 @@
+/* regoracle: register-allocation trace for tools/regoracle.py (EDS decomp).
+   Inactive unless REGORACLE_OUT and REGORACLE_FUNC are set in the environment; it then appends a
+   line-oriented trace of the named function's register allocation to REGORACLE_OUT.  Tracing never
+   changes code generation.  REGORACLE_PRIO / REGORACLE_FORCE are what-if overrides (they do).  */
+
+#ifndef GCC_REGORACLE_H
+#define GCC_REGORACLE_H
+
+#include <stdio.h>
+
+extern FILE *ro_file;		/* trace stream, 0 when tracing is off */
+extern int ro_active;		/* nonzero while compiling the traced function */
+extern const char *ro_pass;	/* name of the pass now running */
+
+extern void ro_init (void);
+extern void ro_reset_function (void);
+extern void ro_new_reg (int);
+extern void ro_new_insn (int);
+extern void ro_begin_function (union tree_node *, struct rtx_def *);
+extern void ro_end_function (void);
+extern void ro_print_rtx (FILE *, struct rtx_def *);
+extern void ro_dump_chain (struct rtx_def *);
+extern void ro_dump_decls (union tree_node *);
+extern void ro_dump_regs (void);
+extern void ro_map_pseudos (void);
+extern void ro_final_insn (struct rtx_def *);
+extern int ro_prio_override (int, int);
+extern int ro_forced_reg (int);
+extern int ro_have_overrides (void);
+extern int ro_collect_pseudos (struct rtx_def *, int *, int);
+extern void ro_insn_regs (struct rtx_def *, int *, int *, int *, int *, int);
+
+#define RO_ON (ro_active && ro_file)
+#define RO_PASS(NAME) (ro_pass = (NAME))
+
+#endif
